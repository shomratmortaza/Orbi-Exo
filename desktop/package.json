{
 "name": "orbi-desktop",
 "version": "1.0.0",
 "description": "ORBI desktop island",
 "main": "main.js",
 "author": "Shomrat Mortaza",
 "license": "UNLICENSED",
 "private": true,
 "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win --publish never"
 },
 "devDependencies": {
  "electron": "^33.2.0",
  "electron-builder": "^25.1.8"
 },
 "build": {
  "appId": "com.shomratmortaza.orbi",
  "productName": "ORBI",
  "files": [
   "main.js",
   "preload.js",
   "offline.html",
   "assets/**"
  ],
  "win": {
   "target": [
    {
     "target": "nsis",
     "arch": [
      "x64"
     ]
    }
   ],
   "icon": "build/icon.ico"
  },
  "nsis": {
   "oneClick": true,
   "perMachine": false,
   "deleteAppDataOnUninstall": false,
   "artifactName": "ORBI-Setup-x64.${ext}"
  }
 }
}